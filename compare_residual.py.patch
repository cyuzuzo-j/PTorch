+class CustomProjectedAdd(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, x, y):
+        ctx.save_for_backward(x, y)
+        return x + y
+
+    @staticmethod
+    def backward(ctx, z_target):
+        x, y = ctx.saved_tensors
+        delta = z_target - (x + y)
+        return x + delta, y + delta
