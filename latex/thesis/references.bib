@article{elser2019learning,
  title        = {Learning Without Loss},
  author       = {Elser, Veit},
  year         = {2019},
  journal      = {Journal of Machine Learning Research},
  volume       = {1},
  pages        = {1--?},
  eprint       = {1911.00493},
  archivePrefix= {arXiv},
  primaryClass = {cs.LG},
  url          = {https://arxiv.org/abs/1911.00493},
  abstract     = {We explore a new approach for training neural networks where all loss functions
                  are replaced by hard constraints. The optimizer, called relaxed-reflect-reflect (RRR),
                  derives its steps from projections to local constraints. This method generalizes
                  successful projection-based optimization from phase retrieval to neural network training.}
}

@article{bergmeister2025projection,
  title        = {A Projection-Based Framework for Gradient-Free and Parallel Learning},
  author       = {Bergmeister, Andreas and Lal, Manish Krishan and Jegelka, Stefanie and Sra, Suvrit},
  year         = {2025},
  journal      = {arXiv preprint arXiv:2506.05878},
  eprint       = {2506.05878},
  archivePrefix= {arXiv},
  primaryClass = {cs.LG},
  url          = {https://arxiv.org/abs/2506.05878},
  abstract     = {We present a feasibility-seeking approach to neural network training using projection
                  operators and iterative projection algorithms, implemented in the PJAX framework.
                  This formulation allows parallelized, gradient-free learning with local updates.}
}
