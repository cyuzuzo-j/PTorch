# Large dataset files (match at any depth)
**/dataset/*.pt
**/dataset/*.tar.gz
**/dataset/*.tar
**/dataset/*.zip

# Python cache
__pycache__/
*.pyc
*.pyo
.pycache/

# Virtual environments
.venv/
venv/
env/

# Jupyter checkpoints
.ipynb_checkpoints/

# Ignore large datasets
dataset/**/*.pt
dataset/**/*.tar.gz
experiments/**/dataset/

# Local Python launcher/temp directories
.python_prefix/
.python_tmp/

# Editor settings
.vscode/

# Weights & Biases local runs and logs
wandb/

# Local experiment debug artifacts
experiments/attention/attention_debug/

# LaTeX build intermediates
*.aux
*.fdb_latexmk
*.fls
